{
  "name": "avogadro",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @avogadro/api",
    "dev:web": "npm run dev --workspace @avogadro/web",
    "dev:api": "npm run dev --workspace @avogadro/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/web/src apps/api/src packages/artifacts/src packages/db/src packages/shared/src apps/worker/src tests",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
